{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RIME saved measurement record 0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "id",
    "captured_at",
    "definition",
    "revision",
    "result"
  ],
  "properties": {
    "format": {
      "const": "rime-measurement-record"
    },
    "version": {
      "const": "0.3"
    },
    "id": {
      "type": "string",
      "pattern": "^measurement-[a-f0-9]{32}$"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "definition": {
      "$ref": "#/$defs/definition"
    },
    "revision": {
      "$ref": "#/$defs/revision"
    },
    "result": {
      "$ref": "#/$defs/result"
    }
  },
  "$defs": {
    "span": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane",
        "label"
      ],
      "properties": {
        "lane": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "observation",
        "exclusions",
        "review_status",
        "review_note"
      ],
      "properties": {
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "observation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          },
          "minItems": 1
        },
        "exclusions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          }
        },
        "review_status": {
          "enum": [
            "unknown",
            "incomplete",
            "complete"
          ]
        },
        "review_note": {
          "type": "string"
        }
      }
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annotation_id",
        "original",
        "clipped"
      ],
      "properties": {
        "annotation_id": {
          "type": "string"
        },
        "original": {
          "$ref": "#/$defs/span"
        },
        "clipped": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "undefined_reason",
        "components",
        "covered_ms",
        "eligible_ms",
        "event_spans",
        "eligible_spans",
        "contributors",
        "scope_contributors"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "enum": [
            "s",
            "%",
            "count"
          ]
        },
        "undefined_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quantity"
          }
        },
        "covered_ms": {
          "type": "number",
          "minimum": 0
        },
        "eligible_ms": {
          "type": "number",
          "minimum": 0
        },
        "event_spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          }
        },
        "eligible_spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          }
        },
        "contributors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contribution"
          }
        },
        "scope_contributors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contribution"
          }
        }
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "study_id",
        "participant_id",
        "visit_id",
        "trial_id",
        "condition",
        "medication_state",
        "bids_session_id"
      ],
      "properties": {
        "study_id": {
          "type": "string"
        },
        "participant_id": {
          "type": "string"
        },
        "visit_id": {
          "type": "string"
        },
        "trial_id": {
          "type": "string"
        },
        "condition": {
          "type": "string"
        },
        "medication_state": {
          "type": "string"
        },
        "bids_session_id": {
          "type": "string"
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "origin_utc",
        "recording_relative_timing_verified"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "origin_utc": {
          "type": "string"
        },
        "recording_relative_timing_verified": {
          "type": "boolean"
        }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file_name",
        "name",
        "role",
        "offset_ms",
        "fps_override",
        "sync_method",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "file_name": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "offset_ms": {
          "type": "number"
        },
        "fps_override": {
          "type": [
            "number",
            "null"
          ]
        },
        "sync_method": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file_name",
        "name",
        "type",
        "format",
        "sampling_rate_hz",
        "time_column",
        "time_reference",
        "time_unit",
        "offset_ms",
        "sync_method",
        "channels",
        "units"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "file_name": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "sampling_rate_hz": {
          "type": "number"
        },
        "time_column": {
          "type": "string"
        },
        "time_reference": {
          "type": "string"
        },
        "time_unit": {
          "type": "string"
        },
        "offset_ms": {
          "type": "number"
        },
        "sync_method": {
          "type": "string"
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "units": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "lane",
        "label",
        "start_ms",
        "end_ms",
        "event_type",
        "source",
        "ghost",
        "confidence",
        "confidence_type",
        "human_modified",
        "origin_confidence",
        "origin_start_ms",
        "origin_end_ms"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "lane": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "start_ms": {
          "type": "number"
        },
        "end_ms": {
          "type": "number"
        },
        "event_type": {
          "enum": [
            "interval",
            "point"
          ]
        },
        "source": {
          "type": "string"
        },
        "ghost": {
          "type": "boolean"
        },
        "confidence": {
          "type": "number"
        },
        "confidence_type": {
          "enum": [
            "human_rating",
            "model_probability",
            "not_recorded"
          ]
        },
        "human_modified": {
          "type": "boolean"
        },
        "origin_confidence": {
          "type": [
            "number",
            "null"
          ]
        },
        "origin_start_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "origin_end_ms": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "source_files",
        "tier_map",
        "label_map",
        "rules_applied"
      ],
      "properties": {
        "origin": {
          "type": "string"
        },
        "source_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tier_map": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "label_map": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "rules_applied": {
          "type": "boolean"
        }
      }
    },
    "protocol": {
      "type": "object",
      "description": "Native ProtocolSchema; its own validator checks lanes, groups, rules, and outcome definitions.",
      "required": [
        "name",
        "version",
        "lanes",
        "groups",
        "rules"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "lanes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "measurements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outcome"
          }
        }
      }
    },
    "annotation_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "timeline_id",
        "rater",
        "protocol",
        "provenance",
        "annotations"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "timeline_id": {
          "type": "string"
        },
        "rater": {
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "provenance": {
          "$ref": "#/$defs/import"
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/annotation"
          }
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "research_context",
        "recordings",
        "annotation_set"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^revision-[a-f0-9]{64}$"
        },
        "research_context": {
          "$ref": "#/$defs/research"
        },
        "recordings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "timeline",
            "videos",
            "signals"
          ],
          "properties": {
            "timeline": {
              "$ref": "#/$defs/timeline"
            },
            "videos": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/video"
              }
            },
            "signals": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/signal"
              }
            }
          }
        },
        "annotation_set": {
          "$ref": "#/$defs/annotation_set"
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "calculation",
        "calculation_version",
        "events",
        "scope"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "calculation": {
          "enum": [
            "covered_duration",
            "percentage_coverage",
            "count"
          ]
        },
        "calculation_version": {
          "const": "1"
        },
        "events": {
          "$ref": "#/$defs/selector"
        },
        "scope": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/selector"
            }
          ]
        }
      }
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "value",
        "unit"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "enum": [
            "s",
            "%",
            "count"
          ]
        }
      }
    }
  }
}
